# Copy this file to .env and fill in your own values.
# backend/.env is read by dotenv at startup and is not committed to git.

# --- MongoDB (required to start) ---
# Defaults to a local MongoDB on the standard port if omitted.
MONGO_URL=mongodb://localhost:27017/
MONGO_DB_NAME=ai_gos_hud

# --- Admin account (optional) ---
# All three must be set together or none are used. On startup the server
# creates this account as admin if it doesn't exist yet, or promotes it to
# admin if it already signed up normally — it never overwrites a password
# that's already set, so this is safe to leave in .env indefinitely.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# --- Server port (optional) ---
# PORT=5000
